<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <!-- Run under Microsoft.Testing.Platform. Test.Sdk 18.x / NUnit3TestAdapter 6.x pull in
             MTP; the .NET 10 SDK then refuses the classic VSTest `dotnet test`. A test project
             is an executable with the NUnit MTP runner enabled. The MTP runner is selected by
             global.json on the .NET 10 SDK (native support) and by
             TestingPlatformDotnetTestSupport on the .NET 8/9 SDK (VSTest-bridge support). -->
        <OutputType>Exe</OutputType>
        <EnableNUnitRunner>true</EnableNUnitRunner>
        <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="../main/Cel.main.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Protobuf Include="generated-pb/**/*.proto" GrpcServices="None" OutputDir="generated-pb/build/generated-src" ProtoRoot="generated-pb/googleapis" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="JsonSubTypes" Version="2.1.0" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
        <PackageReference Include="NUnit" Version="3.14.0" />
        <PackageReference Include="NUnit3TestAdapter" Version="6.2.0" />
        <PackageReference Include="NUnit.ConsoleRunner" Version="3.22.0" />
        <PackageReference Include="NodaTime" Version="3.3.3" />
        <PackageReference Include="Google.Protobuf" Version="3.26.1" />
        <PackageReference Include="Grpc.Net.Client" Version="2.63.0" />
        <PackageReference Include="Grpc.Tools" Version="2.63.0">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
    </ItemGroup>

    <Target Name="Clean">
        <RemoveDir Directories="generated-pb/build" />
    </Target>

</Project>

